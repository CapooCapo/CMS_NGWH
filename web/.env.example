MY_MEMORY_KEY=
# Required in every environment: stable server-only HMAC secret for PostgreSQL login limits.
# Generate a random secret; use the same value on every application instance.
LOGIN_RATE_LIMIT_SECRET=
TRUST_PROXY_X_FORWARDED_FOR=true
# Set to true for database providers with a verified TLS certificate chain.
DB_SSL=true
# Production CSP report collector URL. CSP remains report-only during rollout.

TEST_ADMIN_USERNAME=biz-admin
TEST_ADMIN_PASSWORD=ci-admin-password

TEST_BIZADMIN_USERNAME=biz-admin
TEST_BIZADMIN_PASSWORD=ci-admin-password

TEST_SUPERADMIN_USERNAME=root-super
TEST_SUPERADMIN_PASSWORD=ci-super-password

TEST_SUBADMIN_USERNAME=read-only
TEST_SUBADMIN_PASSWORD=ci-subadmin-password